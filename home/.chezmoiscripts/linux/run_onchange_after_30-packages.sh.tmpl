#!/usr/bin/env bash
#
# Linux is servers-only, so this installs a deliberately minimal set from the
# Aptfile.
#
# Aptfile sha256: {{ include "Aptfile" | sha256sum }}
set -euo pipefail

info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m==>\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31m==>\033[0m %s\n' "$*" >&2; exit 1; }

source_dir="${CHEZMOI_SOURCE_DIR:-{{ .chezmoi.sourceDir }}}"
aptfile="$source_dir/Aptfile"
[ -f "$aptfile" ] || die "No Aptfile at $aptfile"

# grep exits 1 when the Aptfile lists no packages, which is not an error.
packages="$(sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$aptfile" \
  | grep -v '^$' \
  | tr '\n' ' ' \
  | sed 's/[[:space:]]*$//')" || packages=""

if [ -z "$packages" ]; then
  info "No packages listed in $aptfile; nothing to install"
  exit 0
fi

sudo_cmd=""
if [ "$(id -u)" -ne 0 ]; then
  command -v sudo >/dev/null 2>&1 || die "Not root and sudo is unavailable"
  # Fail loudly rather than hang when apply runs without a terminal, e.g.
  # under an unattended topgrade run.
  sudo -n true 2>/dev/null || [ -t 0 ] \
    || die "sudo needs a password but there is no TTY. Run 'chezmoi apply' interactively."
  sudo_cmd="sudo"
fi

info "Installing packages: $packages"

if command -v apt-get >/dev/null 2>&1; then
  # shellcheck disable=SC2086
  $sudo_cmd apt-get update
  # shellcheck disable=SC2086
  DEBIAN_FRONTEND=noninteractive $sudo_cmd apt-get install -y $packages
elif command -v dnf >/dev/null 2>&1; then
  # shellcheck disable=SC2086
  $sudo_cmd dnf install -y $packages
elif command -v pacman >/dev/null 2>&1; then
  # shellcheck disable=SC2086
  $sudo_cmd pacman -Sy --needed --noconfirm $packages
else
  warn "No supported package manager found (apt-get, dnf, pacman)."
  warn "Install manually: $packages"
  exit 0
fi

info "Packages installed"
