{{- $profile := dig "profile" "server" . -}}
#!/usr/bin/env bash
#
# Re-runs whenever the rendered content below changes -- that is, on any
# Brewfile edit (via the hash) or any profile change (via the value baked into
# the command). Nothing else re-triggers it.
#
# Brewfile sha256: {{ include "Brewfile" | sha256sum }}
# Device profile:  {{ $profile }}
set -euo pipefail

info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
die() { printf '\033[1;31m==>\033[0m %s\n' "$*" >&2; exit 1; }

# Each chezmoi script is its own process, so Homebrew's PATH change from the
# install script above has not reached us.
if ! command -v brew >/dev/null 2>&1; then
  for prefix in /opt/homebrew /usr/local; do
    if [ -x "$prefix/bin/brew" ]; then
      eval "$("$prefix/bin/brew" shellenv)"
      break
    fi
  done
fi
command -v brew >/dev/null 2>&1 || die "Homebrew is not on PATH"

source_dir="${CHEZMOI_SOURCE_DIR:-{{ .chezmoi.sourceDir }}}"
brewfile="$source_dir/Brewfile"
[ -f "$brewfile" ] || die "No Brewfile at $brewfile"

info "brew bundle (device profile: {{ $profile }})"
HOMEBREW_DEVICE_PROFILE={{ $profile | quote }} brew bundle --file="$brewfile"

info "Packages installed"
